# Only the anon/publishable key is used - this backend has no privileged
# credential. Every request runs as the caller's own JWT, and Postgres RLS
# enforces ownership. See docs/architecture-decisions.md ADR-005.
SUPABASE_URL=
SUPABASE_ANON_KEY=

BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000

# NEXT_PUBLIC_ vars are bundled into client JS and are visible to anyone -
# that's fine here because this is the anon key, which is meant to be
# public; Postgres RLS (not secrecy of this key) is what protects data.
# There is no privileged/service-role key anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
